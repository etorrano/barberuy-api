// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPERADMIN
  ADMIN
  CLIENT
  STAFF
}

model User {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email    String  @unique

  name String?
  password String
  role UserRole @default(CLIENT)

  admin   Admin?
  clients Client?
  staff Staff?

  @@unique([id, email, name])
}

model Admin {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation(fields: [userId,userEmail, userName], references: [id, email, name])
  userId Int
  userEmail String
  userName String

  salesPoints SalesPoint[]

  @@unique([userId, userEmail, userName])
}

model Client {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation(fields: [userId,userEmail, userName], references: [id, email, name])
  userId Int
  userEmail String
  userName String

  @@unique([userId, userEmail, userName])
}

model Staff {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation(fields: [userId,userEmail, userName], references: [id, email, name])
  userId Int
  userEmail String
  userName String

  workshifts WorkShift[]
  services StaffService[]

  @@unique([id, userEmail, userName])
  @@unique([userId, userEmail, userName])
}

model WorkShift {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startTime DateTime @db.Time(4)
  endTime DateTime @db.Time(4)

  staff Staff[]
}

model Company {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  companyName String
  RUT Int

  business Business[]
  salesPoints SalesPoint[]
}

model Business {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  key String

  companies Company[]
}

model SalesPoint {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  street String
  streetNumber String
  floor String?

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  services Service[]

  admins Admin[]

  @@unique([street, streetNumber, floor])
}

model Service {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  key String @unique
  name String
  cost Int
  duration Int // minutes

  salesPoint   SalesPoint @relation(fields: [salesPointId], references: [id])
  salesPointId Int

  staff StaffService[]
  promotions Promotion[]

  @@unique([key, name])
  @@unique([id, name, salesPointId])
}

model StaffService {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff   Staff @relation(fields: [staffId,staffEmail, staffName], references: [id, userEmail, userName])
  staffId Int
  staffEmail String
  staffName String

  service   Service @relation(fields: [serviceId, serviceName, serviceSalesPointId], references: [id, name, salesPointId])
  serviceId Int
  serviceName String
  serviceSalesPointId Int

  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  scheduleId Int

  @@unique([id, serviceId, serviceName, serviceSalesPointId, staffEmail, staffName])
}

model Schedule {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startDate DateTime
  endDate DateTime

  service StaffService[]
  reviews Review[]
}

enum ReviewType {
  Service
  Staff
  SalesPoint
}

model Review {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  score Int
  comment String
  type ReviewType

  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  scheduleId Int
}

enum PromotionType {
  Percentage
  Number
}

model Promotion {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  type PromotionType
  value Int
  startDate DateTime
  endDate DateTime
  enabled Boolean

  services Service[]
}