// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

enum UserRole {
  SUPERADMIN
  ADMIN
  CLIENT
  STAFF
}

enum Days {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email    String  @unique

  name String?
  password String
  role UserRole @default(CLIENT)
  active Boolean @default(true)

  admin   Admin?
  clients Client?
  staff Staff?

  @@unique([id, email, name])
}

model Admin {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation(fields: [userId,userEmail, userName], references: [id, email, name])
  userId Int
  userEmail String
  userName String

  salesPoints SalesPoint[]

  @@unique([userId, userEmail, userName])
}

model Client {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation(fields: [userId,userEmail, userName], references: [id, email, name])
  userId Int
  userEmail String
  userName String

  schedules Schedule[]

  @@unique([userId, userEmail, userName])
  @@unique([id, userName])
}

model Staff {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation(fields: [userId,userEmail, userName], references: [id, email, name])
  userId Int
  userEmail String
  userName String

  workshifts WorkShift[]
  services StaffService[]
  salesPoints SalesPoint[]

  @@unique([id, userEmail, userName])
  @@unique([userId, userEmail, userName])
}

model WorkShift {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days Days[]

  title String
  startTime String
  endTime String

  staff Staff[]
  salesPoint SalesPoint[]
}

model Company {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  companyName String
  RUT Int

  business Business[]
  salesPoints SalesPoint[]
}

model Business {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  key String

  companies Company[]
}

model SalesPoint {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String @unique
  street String
  streetNumber String
  floor String?

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  admins Admin[]

  staff Staff[]

  staffServices StaffService[]

  workshifts WorkShift[]

  @@unique([street, streetNumber, floor])
  @@unique([id, name])
}

model Service {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  key String @unique
  name String
  cost Int
  duration Int // minutes
  durationSteps Int[]

  staff StaffService[]
  promotions Promotion[]

  @@unique([key, name])
  @@unique([id, name])
}

model StaffService {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff   Staff @relation(fields: [staffId,staffEmail, staffName], references: [id, userEmail, userName])
  staffId Int
  staffEmail String
  staffName String

  service   Service @relation(fields: [serviceId, serviceName], references: [id, name])
  serviceId Int
  serviceName String

  salesPoint SalesPoint @relation(fields: [salesPointId, salesPointName], references: [id, name])
  salesPointId Int
  salesPointName String

  schedules Schedule[]

  @@unique([id, serviceId, serviceName, staffEmail, staffName, salesPointId, salesPointName])
  @@unique(name: "group_id", [serviceId, staffId, salesPointId])
}

model Schedule {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startDate DateTime
  endDate DateTime

  client   Client @relation(fields: [clientId, clientName], references: [id, userName])
  clientId Int
  clientName String

  service StaffService[]
  reviews Review[]

  @@unique([id, startDate, endDate])
}

enum ReviewType {
  Service
  Staff
  SalesPoint
}

model Review {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  score Int
  comment String
  type ReviewType

  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  scheduleId Int
}

enum PromotionType {
  Percentage
  Number
}

model Promotion {
  id       Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  type PromotionType
  value Int
  startDate DateTime
  endDate DateTime
  enabled Boolean

  services Service[]
}